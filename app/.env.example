# Copy this file to .env for local development. On Vercel, add the same names under
# Project → Settings → Environment Variables. Never commit the real .env file.

# OpenRouteService (driving routes): https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Geoapify (place search, sights, places to stay): https://myprojects.geoapify.com
GEOAPIFY_API_KEY=

# Optional: an email for OpenStreetMap's Nominatim, used only if GEOAPIFY_API_KEY is empty.
CONTACT_EMAIL=

# Supabase (saved trips, price list, feedback): Project Settings → API. Public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Shown on the Privacy page, and used for feedback if Supabase isn't set up.
VITE_CONTACT_EMAIL=
VITE_FEEDBACK_EMAIL=

# Booking.com affiliate id (aid), once approved.
VITE_BOOKING_AID=
